{
  "name": "@ergane/modulo-pagamento",
  "version": "0.1.0",
  "description": "Módulo de pagamentos do SaaS Ergane",
  "main": "dist/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
