# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP do módulo de pagamentos
PORT=3000

# Provedor de pagamento ativo. Hoje apenas o simulador local.
PAYMENT_GATEWAY=fake

# Chave da API do Google Gemini, usada para interpretar cobranças faladas.
# Vive apenas no servidor: o navegador chama /api do Ergane e nunca vê a chave.
# Ausente, o módulo cai num interpretador local por regex (veja /health).
GEMINI_API_KEY=

# Modelo do Gemini. Confira os disponíveis com:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-2.5-flash
